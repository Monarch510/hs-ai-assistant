# ============================================================
# 运行产物：全部可由程序重建，不进仓库
# 对照 hsai/paths.py —— 那边定义了路径，这里负责挡住它们
# （唯一例外是 data/effects.json：它是可复现的行为定义，要入库）
# ============================================================

# 卡牌库缓存
data/cards_*.json

# 卡组与环境
# meta/ 是「一个原型一个文件」；meta_backup/ 是 rebuild 前的自动备份
data/meta.json
data/meta.json.migrated
data/meta.backup.json
data/meta/
data/meta_backup/
data/meta_before_*/
data/our_deck.json

# 对局记录
data/observations.jsonl
data/games.jsonl
data/last_review.json
data/advice_log.jsonl
data/advice_feedback.jsonl

# 长期记忆
data/lessons.jsonl*
data/cases.jsonl
data/opp_history.jsonl

# 卡牌功能标签：可重生成；ai/manual 是本地补标输入，同样不进仓库
data/card_tags.json
data/card_tags_ai.json
data/card_tags_manual.json
data/card_tags_pending.jsonl

# 权重
data/policy_weights.json
data/mulligan_weights.json
data/tag_weights.json

# 运行状态与诊断
data/window.json
data/install_dir.txt
data/hsai.log
data/*.bak

# ============================================================
# 可能含密钥，绝不入库
# ============================================================
data/ai.json

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/

# ============================================================
# 编辑器
# ============================================================
.vscode/
.idea/
*.swp

# ============================================================
# 本地 AI 代理的工作记录（个人笔记，不属于项目代码）
# ============================================================
.workbuddy-ai/

# 运行时/工具产物，不入库
.agent-teams/
.workbuddy/
docs/plan/_*.txt
# 各 AI 干活时的临时调试脚本/输出（_dbg_*.py、_dbg_out/），用完就该删
_dbg_*

# docs/ 只作本地记录，不入库
docs/

# auto-task/：脚本与说明入库，队列运行数据只在本地
auto-task/*.md
auto-task/*.txt
!auto-task/_README.md
auto-task/.claims/
auto-task/done/
auto-task/archive/

# 沙箱里跑测试的本地包装（DSH Windows 临时目录权限绕过），不入库
data/run_tests.py
